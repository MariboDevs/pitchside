// The query the Activator rule "pressure alert" watches (WP-12). It mirrors the sustained_pressure moment
// (SustainedPressureRule in Pitchside.Moments): the same 3-minute window of period clock, counted back from each shot
// of a side, never across half time. The alert threshold is 4 shots, one more than the moment's 3, so the alert
// marks the stronger spells. Unlike the moment, it does not stand down when the side scores in the window.
//
// Each row is one shot, published within the lookback, that brought its side to 4 or more shots in the window.
// Activator runs it every minute, and its source keeps only the rows published in one whole clock minute, the one
// that ended 2 minutes before the run (time for ingestion). Consecutive runs take consecutive minutes, so each row
// reaches the rule once and each shot sends one alert, not one per poll. PressureAlertParityTests in
// tests/Pitchside.Fabric.Tests fails if windowMs differs from SustainedPressureRule.WindowMs.
.create-or-alter function with (folder = "pitchside/alerts", docstring = "Shots that bring a side to 4 shots in 3 minutes") PressureAlerts(lookback: timespan = 30m) {
    let windowMs = 180000;
    let shotThreshold = 4;
    // The lookback picks the shots that may raise an alert now. The shots they are counted against are all of those
    // matches' shots, so a pause or a slow replay between two shots of one spell never hides it.
    let live = events
        | where publishedUtc > ago(lookback)
        | distinct matchId;
    let shots = events
        | where matchId in (live)
        | summarize arg_max(publishedUtc, *) by matchId, seq
        | where type == "shot"
        | project matchId, teamId, period, seq, clockMs, wallTimeUtc, publishedUtc;
    shots
    | where publishedUtc > ago(lookback)
    | join kind=inner (shots | project matchId, teamId, period, earlierSeq = seq, earlierClockMs = clockMs) on matchId, teamId, period
    | where earlierSeq <= seq and earlierClockMs >= clockMs - windowMs
    | summarize shotsInWindow = count() by matchId, teamId, period, seq, clockMs, wallTimeUtc, publishedUtc
    | where shotsInWindow >= shotThreshold
    | extend matchMinute = (period - 1) * 45 + clockMs / 60000 + 1, alertId = strcat(matchId, ":", seq)
    | order by publishedUtc asc
}
