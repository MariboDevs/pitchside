{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitchside.maribodevs.com/schemas/moment.schema.json",
  "title": "Pitchside moment",
  "description": "A span of events a rule decided matters, with its evidence. No model is involved in producing it.",
  "type": "object",
  "required": ["id", "matchId", "type", "priority", "period", "clockMs", "triggerSeq", "window", "sideId", "playerIds", "evidence", "headline", "factSheetSeq"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^MER-[0-9]+(-[0-9]+)?:M:[0-9]{4,}:[a-z_]+$" },
    "matchId": { "type": "string", "pattern": "^MER-[0-9]+(-[0-9]+)?$" },
    "type": {
      "type": "string",
      "enum": ["goal", "red_card", "penalty", "big_chance_missed", "momentum_swing", "sustained_pressure", "milestone", "speed_tag", "pass_tag", "kick_off", "half_time", "full_time"]
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "period": { "type": "integer", "enum": [1, 2] },
    "clockMs": { "type": "integer", "minimum": 0 },
    "triggerSeq": { "type": "integer", "minimum": 1 },
    "window": {
      "type": "object",
      "required": ["fromSeq", "toSeq"],
      "additionalProperties": false,
      "properties": {
        "fromSeq": { "type": "integer", "minimum": 1 },
        "toSeq": { "type": "integer", "minimum": 1 }
      }
    },
    "sideId": { "type": ["string", "null"] },
    "playerIds": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "object",
      "required": ["eventIds", "factKeys"],
      "additionalProperties": false,
      "properties": {
        "eventIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "factKeys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "factSheetSeq": { "type": "integer", "minimum": 1 }
  }
}
