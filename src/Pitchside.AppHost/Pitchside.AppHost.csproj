<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <RootNamespace>Pitchside.AppHost</RootNamespace>
    <UserSecretsId>pitchside-apphost</UserSecretsId>
    <!-- The CLI bundle is a developer-machine convenience; CI and the sandbox build without it. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pitchside.Api/Pitchside.Api.csproj" />
    <ProjectReference Include="../Pitchside.Agents.Host/Pitchside.Agents.Host.csproj" />
  </ItemGroup>
</Project>
